diff --git a/tests/dynamixel_integer_test.cpp b/tests/dynamixel_integer_test.cpp
new file mode 100644
index 0000000..9f9ec08
--- /dev/null
+++ b/tests/dynamixel_integer_test.cpp
@@ -0,0 +1,31 @@
+#include "dynamixel_control/dynamixel_client.h"
+#include <cassert>
+#include <limits>
+
+int main()
+{
+  for (int size = 1; size <= 4; ++size)
+  {
+    const uint64_t half = uint64_t{1} << (8 * size - 1);
+    const uint32_t mask = static_cast<uint32_t>((half << 1) - 1);
+    assert(DynamixelClient::unsigned_to_signed(0, size) == 0);
+    assert(DynamixelClient::unsigned_to_signed(1, size) == 1);
+    assert(DynamixelClient::unsigned_to_signed(half - 1, size) == static_cast<int64_t>(half) - 1);
+    assert(DynamixelClient::unsigned_to_signed(half, size) == -static_cast<int64_t>(half));
+    assert(DynamixelClient::unsigned_to_signed(mask, size) == -1);
+    assert(DynamixelClient::signed_to_unsigned(-1, size) == mask);
+    assert(DynamixelClient::signed_to_unsigned(-static_cast<int64_t>(half), size) == half);
+    assert(DynamixelClient::signed_to_unsigned(half - 1, size) == half - 1);
+  }
+  assert(DynamixelClient::unsigned_to_signed(0xFFFFFFFFu, 2) == -1);
+  for (int size : {-1, 0, 5, 32})
+  {
+    bool decode_failed = false;
+    bool encode_failed = false;
+    try { DynamixelClient::unsigned_to_signed(0, size); }
+    catch (const std::invalid_argument &) { decode_failed = true; }
+    try { DynamixelClient::signed_to_unsigned(0, size); }
+    catch (const std::invalid_argument &) { encode_failed = true; }
+    assert(decode_failed && encode_failed);
+  }
+}
