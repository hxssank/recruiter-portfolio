+def make_model(free: bool = False, ball: bool = False) -> mujoco.MjModel:
+    root_joint = "<freejoint/>" if free else ""
+    extra = (
+        '<body><joint type="ball"/><geom type="sphere" size="0.01" mass="0.1"/></body>'
+        if ball
+        else ""
+    )
+    return mujoco.MjModel.from_xml_string(f"""<mujoco>
+      <worldbody><body name="torso" pos="0 0 1">{root_joint}
+        <geom type="sphere" size="0.1" mass="1"/>
+        <body><joint name="motor"/><geom type="capsule" size="0.02 0.1" mass="0.1"/>{extra}</body>
+      </body></worldbody>
