+    msg = comm.ZMQMessage(np.float32(1), control_inputs={"walk_x": np.float32(0.5)})
+    decoded, _, _ = comm.decode_message(comm.encode_message(msg))
+    assert decoded.time == 1
+    assert decoded.control_inputs == {"walk_x": 0.5}
