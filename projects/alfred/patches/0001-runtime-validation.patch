+def test_current_sensor_mask_selects_each_motor_model():
+    import ast
+    from types import SimpleNamespace
+
+    import numpy as np
+    import numpy.typing as npt
+
+    source = Path(__file__).resolve().parents[1] / "toddlerbot/sim/real_world.py"
+    tree = ast.parse(source.read_text())
+    cls = next(node for node in tree.body if isinstance(node, ast.ClassDef))
+    method = next(
+        node
+        for node in cls.body
+        if isinstance(node, ast.FunctionDef) and node.name == "motor_cur_to_tor"
+    )
+    namespace = {"np": np, "npt": npt}
+    exec(  # noqa: S102 - Load the local numerical method without hardware imports.
+        compile(ast.Module(body=[method], type_ignores=[]), str(source), "exec"),
+        namespace,
+    )
+    robot = SimpleNamespace(
+        cur_sensor_mask=[1, 0, 1],
+        motor_bi=np.array([0.1, 0.1, 0.1]),
+        motor_ki=np.array([0.5, 0.5, 0.5]),
+        motor_tau_max=np.array([10, 10, 10]),
+    )
+    result = namespace["motor_cur_to_tor"](
+        SimpleNamespace(robot=robot),
+        np.array([500, 500, -500], dtype=np.float32),
+        np.array([1, 1, 1], dtype=np.float32),
+    )
+    np.testing.assert_allclose(result, [0.8, 5.0, -2.4])
