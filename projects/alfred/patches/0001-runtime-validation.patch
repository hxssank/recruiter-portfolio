+def test_authenticated_loopback_exchange(monkeypatch):
+    import socket
+    import time
+
+    monkeypatch.setenv("TODDLERBOT_ZMQ_KEY", KEY.decode())
+    with socket.socket() as port_probe:
+        port_probe.bind(("127.0.0.1", 0))
+        port = port_probe.getsockname()[1]
+    receiver = comm.ZMQNode(type="receiver", ip="127.0.0.1", port=port)
+    sender = comm.ZMQNode(type="sender", port=port)
+    try:
+        sender.send_msg(comm.ZMQMessage(123, action=np.array([1.5, -0.5])))
+        deadline = time.monotonic() + 2
+        message = None
+        while message is None and time.monotonic() < deadline:
+            message = receiver.get_msg()
+            if message is None:
+                time.sleep(0.01)
+        assert message is not None
+        np.testing.assert_array_equal(message.action, [1.5, -0.5])
+        assert receiver.rejected_messages == 0
+    finally:
+        sender.close()
+        receiver.close()
