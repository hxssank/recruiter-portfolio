+import json
+import subprocess
+from collections import deque
+
+import numpy as np
+import pytest
+import zmq
+
+from toddlerbot.utils import comm_utils as comm
+
+KEY = b"test-only-secret-that-is-32-bytes!"
+
+
+def test_round_trip_all_fields():
+    msg = comm.ZMQMessage(
+        time=1.25,
+        control_inputs={"walk_x": 0.5},
+        action=np.arange(32, dtype=np.float32),
+        fsr=np.array([1, 2], dtype=np.float32),
+        camera_frame=np.arange(32, dtype=np.uint8).reshape(32, 1),
+        text="hello",
+    )
+    decoded, nonce, _ = comm.decode_message(comm.encode_message(msg, KEY), KEY)
+    assert decoded.time == msg.time
+    assert decoded.control_inputs == msg.control_inputs
+    assert decoded.text == msg.text
+    assert len(nonce) == 32
+    for name in ("action", "fsr", "camera_frame"):
+        np.testing.assert_array_equal(getattr(decoded, name), getattr(msg, name))
+
+
+@pytest.mark.parametrize("key", [b"", b"wrong-key"])
+def test_requires_matching_key(key):
+    with pytest.raises(ValueError, match="authentication"):
+        comm.decode_message(comm.encode_message(comm.ZMQMessage(0), KEY), key)
+
+
+def test_tampering_rejected():
+    packet = comm.encode_message(comm.ZMQMessage(0), KEY)
+    with pytest.raises(ValueError, match="authentication"):
+        comm.decode_message(packet[:-1] + b"x", KEY)
+
+
+@pytest.mark.parametrize(
+    "payload", [b"\x80\x04pickle", b"{}", b"x" * (comm.MAX_PACKET_BYTES + 1)]
+)
+def test_legacy_and_oversized_packets_rejected(payload):
+    with pytest.raises(ValueError):
+        comm.decode_message(payload)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"time": float("nan")},
+        {"time": True},
+        {"action": np.array([float("inf")])},
+        {"action": np.zeros(257)},
+        {"action": np.zeros((2, 2))},
+        {"control_inputs": {"walk_x": "1"}},
+        {"camera_frame": np.zeros(3, dtype=np.float32)},
+        {"text": "x" * 16385},
+    ],
+)
+def test_invalid_fields_rejected(kwargs):
+    with pytest.raises((ValueError, TypeError)):
+        comm.encode_message(comm.ZMQMessage(**({"time": 0} | kwargs)))
+
+
+def test_forged_array_shape_rejected():
+    packet = comm.encode_message(comm.ZMQMessage(0, action=np.zeros(2)))
+    envelope = json.loads(packet[36:])
+    envelope["message"]["action"]["shape"] = [3]
+    with pytest.raises(ValueError, match="length"):
+        comm.decode_message(packet[:36] + json.dumps(envelope).encode())
+
+
+@pytest.mark.parametrize("offset", [31, -6])
+def test_expired_or_future_packets_rejected(monkeypatch, offset):
+    monkeypatch.setattr(comm.time, "time", lambda: 100)
+    packet = comm.encode_message(comm.ZMQMessage(0), KEY)
+    monkeypatch.setattr(comm.time, "time", lambda: 100 + offset)
+    with pytest.raises(ValueError, match="expired"):
+        comm.decode_message(packet, KEY)
+
+
+class FakeSocket:
+    def __init__(self, packets):
+        self.packets = deque(packets)
+
+    def recv(self, flags):
+        if not self.packets:
+            raise zmq.Again
+        return self.packets.popleft()
+
+
+def test_replay_and_bad_packets_are_dropped():
+    packet = comm.encode_message(comm.ZMQMessage(0, text="safe"), KEY)
+    node = comm.ZMQNode.__new__(comm.ZMQNode)
+    node.type = "receiver"
+    node.key = KEY
+    node.socket = FakeSocket([b"invalid", packet, packet])
+    node._seen = {}
+    node.rejected_messages = 0
+    assert node.get_msg().text == "safe"
+    assert node.rejected_messages == 2
+    assert node.get_msg() is None
+
+
+@pytest.mark.parametrize("kind", ["sender", "receiver"])
+def test_remote_requires_secret(monkeypatch, kind):
+    monkeypatch.delenv("TODDLERBOT_ZMQ_KEY", raising=False)
+    with pytest.raises(ValueError, match="require"):
+        comm.ZMQNode(type=kind, ip="192.0.2.1")
+
+
+def test_bind_is_loopback_by_default(monkeypatch):
+    monkeypatch.delenv("TODDLERBOT_ZMQ_KEY", raising=False)
+    monkeypatch.delenv("TODDLERBOT_ZMQ_BIND_IP", raising=False)
+    monkeypatch.setattr(comm.ZMQNode, "start_zmq", lambda self: None)
+    assert comm.ZMQNode(type="receiver").ip == "127.0.0.1"
+
+
+def test_explicit_bind_uses_secret(monkeypatch):
+    monkeypatch.setenv("TODDLERBOT_ZMQ_KEY", KEY.decode())
+    monkeypatch.setenv("TODDLERBOT_ZMQ_BIND_IP", "192.0.2.2")
+    monkeypatch.setattr(comm.ZMQNode, "start_zmq", lambda self: None)
+    node = comm.ZMQNode(type="receiver")
+    assert node.ip == "192.0.2.2"
+    assert node.key == KEY
+
+
+def test_time_sync_does_not_invoke_shell(monkeypatch):
+    calls = []
+
+    def run(args, **kwargs):
+        calls.append((args, kwargs))
+        return subprocess.CompletedProcess(args, 0, stdout="ok")
+
+    monkeypatch.setattr(comm.subprocess, "run", run)
+    comm.sync_time("127.0.0.1")
+    assert calls[0][0] == ["sudo", "-n", "ntpdate", "-u", "127.0.0.1"]
+    assert "shell" not in calls[0][1]
+    with pytest.raises(ValueError):
+        comm.sync_time("127.0.0.1; touch /tmp/unwanted")
+    assert len(calls) == 1
+
+
