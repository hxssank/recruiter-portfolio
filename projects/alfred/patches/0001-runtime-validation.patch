+from pathlib import Path
+
+import joblib
+import numpy as np
+import pytest
+
+from toddlerbot.utils.dataset_utils import Data, DatasetLogger
+
+
+def entry(value: float) -> Data:
+    return Data(value, np.array([value]), np.array([value]))
+
+
+def test_sessions_do_not_mix_or_overwrite(tmp_path: Path) -> None:
+    first, second = DatasetLogger(tmp_path), DatasetLogger(tmp_path)
+    first.log_entry(entry(1))
+    second.log_entry(entry(2))
+    first_file, second_file = first.save(), second.save()
+    assert first_file != second_file
+    output = tmp_path / "experiment"
+    first.move_files_to_exp_folder(str(output))
+    assert len(list(output.glob("*.lz4"))) == 1
+    second.move_files_to_exp_folder(str(output))
+    assert sorted(joblib.load(path)["start_time"] for path in output.glob("*.lz4")) == [
+        1,
+        2,
+    ]
+    first.move_files_to_exp_folder(str(output))
+    assert len(list(output.glob("*.lz4"))) == 2
+    assert first_file.exists() and second_file.exists()
+
+
+def test_empty_save_is_noop(tmp_path: Path) -> None:
+    logger = DatasetLogger(tmp_path)
+    assert logger.save() is None
+    assert logger.n_episodes == 0
+
+
+def test_failed_save_retains_samples(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    logger = DatasetLogger(tmp_path)
+    logger.log_entry(entry(3))
+
+    def fail(*args, **kwargs):
+        raise OSError("disk full")
+
+    monkeypatch.setattr(joblib, "dump", fail)
+    with pytest.raises(OSError, match="disk full"):
+        logger.save()
+    assert logger.n_episodes == 0
+    assert len(logger.data_list) == 1
+    assert not list(logger.session_dir.iterdir())
+
+
+def test_existing_episode_is_preserved(tmp_path: Path) -> None:
+    logger = DatasetLogger(tmp_path)
+    logger.log_entry(entry(1))
+    first = logger.save()
+    logger.n_episodes = 0
+    logger.log_entry(entry(2))
+    with pytest.raises(FileExistsError):
+        logger.save()
+    assert joblib.load(first)["start_time"] == 1
+    assert len(logger.data_list) == 1
+
+
+def test_export_conflict_keeps_original(tmp_path: Path) -> None:
+    logger = DatasetLogger(tmp_path)
+    logger.log_entry(entry(7))
+    original = logger.save()
+    output = tmp_path / "out"
+    logger.move_files_to_exp_folder(str(output))
+    exported = next(output.glob("*.lz4"))
+    exported.write_bytes(b"other data")
+    with pytest.raises(FileExistsError):
+        logger.move_files_to_exp_folder(str(output))
+    assert joblib.load(original)["start_time"] == 7
+    assert exported.read_bytes() == b"other data"
