+def test_integer_register_boundaries_under_ubsan(tmp_path):
+    compiler = shutil.which("clang++") or shutil.which("g++")
+    if compiler is None:
+        pytest.skip("C++ compiler unavailable")
+    root = Path(__file__).resolve().parents[1]
+    executable = tmp_path / "dynamixel-integers"
+    include = root / "toddlerbot/actuation/include"
+    subprocess.run(
+        [
+            compiler,
+            "-std=c++17",
+            "-fsanitize=undefined",
+            "-fno-sanitize-recover=all",
+            "-ffunction-sections",
+            "-fdata-sections",
+            "-Wl,-dead_strip" if sys.platform == "darwin" else "-Wl,--gc-sections",
+            "-I",
+            str(include),
+            "-I",
+            str(include / "dynamixel_control"),
+            "-I",
+            str(include / "dynamixel_sdk"),
+            str(root / "tests/dynamixel_integer_test.cpp"),
+            str(
+                root / "toddlerbot/actuation/src/dynamixel_control/dynamixel_client.cpp"
+            ),
+            "-o",
+            str(executable),
+        ],
+        check=True,
+        capture_output=True,
+        timeout=60,
+    )
+    subprocess.run([str(executable)], check=True, capture_output=True, timeout=10)
+
